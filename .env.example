# Copy to .env locally; never commit the populated file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=
# Copy users.example.json to users.json and set the diary owners and labels.
DIARY_USERS_FILE=users.json

OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-transcribe
ENTRY_SUMMARY_MODEL=gpt-4.1-mini
DAILY_SUMMARY_MODEL=gpt-4.1-mini

# npm run google-auth creates the private root and prints its ID.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_CREDENTIALS_FILE=credentials/google-oauth-client.json
GOOGLE_TOKEN_FILE=tokens/google-token.json

TIMEZONE=Europe/London
DATA_DIR=data
# Each diary keeps its own start date in data/users/<ID>/state.json.
RETAIN_LOCAL_AUDIO=true
# false allows core to remove audio only after transcription + verified Drive archive.

IMMEDIATE_ATTEMPTS=3
RETRY_BASE_MS=1000
RETRY_INTERVAL_MS=900000
ATTENTION_AFTER_MS=3600000
HTTP_TIMEOUT_MS=120000
