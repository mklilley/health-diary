[Unit]
Description=Health diary retry and recovery pass
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=health-diary
Group=health-diary
WorkingDirectory=/srv/health-diary
# Keep this PATH consistent with the system-wide Node used to launch PM2.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=TZ=Europe/London
# src/config.js loads /srv/health-diary/.env using the same parser as PM2.
ExecStart=/usr/bin/env node src/jobs/retry.js
UMask=0077
TimeoutStartSec=45min
TimeoutStopSec=180s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/health-diary/data /srv/health-diary/tokens
